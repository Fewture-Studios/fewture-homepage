# src/pages/Ingest.jsx
ingest_jsx = """import React, { useState } from 'react'
import { API_URL } from '../config'

export default function Ingest() {
  const [text, setText] = useState('')
  const [title, setTitle] = useState('')
  const [source, setSource] = useState('writers_room')
  const [meta, setMeta] = useState('{"project":"demo"}')
  const [resp, setResp] = useState(null)
  const [loading, setLoading] = useState(false)

  async function submit() {
    setLoading(true)
    try {
      const r = await fetch(`${API_URL}/ingest/text`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          text, title, source, metadata: JSON.parse(meta || '{}'),
          chunk_size: 1200, chunk_overlap: 200
        })
      })
      const data = await r.json()
      setResp(data)
    } catch (e) {
      setResp({ error: e.message })
    } finally {
      setLoading(false)
    }
  }

  return (
    <div className="panel">
      <h2>Ingest Text</h2>
      <div className="row">
        <div>
          <label>Title</label>
          <input className="input" value={title} onChange={e=>setTitle(e.target.value)} placeholder="Doc title" />
        </div>
        <div>
          <label>Source</label>
          <input className="input" value={source} onChange={e=>setSource(e.target.value)} placeholder="writers_room / brief / script" />
        </div>
      </div>
      <label>Metadata (JSON)</label>
      <textarea rows={4} className="input" value={meta} onChange={e=>setMeta(e.target.value)} />
      <label>Text</label>
      <textarea rows={12} className="input" value={text} onChange={e=>setText(e.target.value)} placeholder="Paste your writers’ room notes, briefs, scripts..." />
      <div style={{ display:'flex', gap:12, marginTop:12 }}>
        <button className="primary" onClick={submit} disabled={loading}>{loading ? 'Ingesting...' : 'Ingest'}</button>
        <span className="small">POST {API_URL}/ingest/text</span>
      </div>
      {resp && (<>
        <hr className="div" />
        <div className="badge">Response</div>
        <pre className="code">{JSON.stringify(resp, null, 2)}</pre>
      </>)}
    </div>
  )
}
"""

# src/pages/Search.jsx
search_jsx = """import React, { useState } from 'react'
import { API_URL } from '../config'

export default function Search() {
  const [q, setQ] = useState('brand pillars for IRL')
  const [topK, setTopK] = useState(5)
  const [results, setResults] = useState(null)
  const [loading, setLoading] = useState(false)

  async function run() {
    setLoading(true)
    try {
      const r = await fetch(`${API_URL}/search?q=${encodeURIComponent(q)}&top_k=${topK}`)
      const data = await r.json()
      setResults(data)
    } catch (e) {
      setResults([{error: e.message}])
    } finally {
      setLoading(false)
    }
  }

  return (
    <div className="panel">
      <h2>Search</h2>
      <div className="row">
        <div>
          <label>Query</label>
          <input className="input" value={q} onChange={e=>setQ(e.target.value)} />
        </div>
        <div>
          <label>Top K</label>
          <input type="number" className="input" value={topK} onChange={e=>setTopK(parseInt(e.target.value||'5'))} />
        </div>
      </div>
      <div style={{ display:'flex', gap:12, marginTop:12 }}>
        <button className="primary" onClick={run} disabled={loading}>{loading ? 'Searching...' : 'Search'}</button>
        <span className="small">GET {API_URL}/search</span>
      </div>
      {results && (<>
        <hr className="div" />
        <div className="badge">Results</div>
        <div className="grid-3">
          {results.map((r, i) => (
            <div key={i} className="panel">
              <div className="small">Score: {r.score?.toFixed?.(4)}</div>
              <div className="small">Doc: {r.document_id} | Chunk: {r.chunk_id}</div>
              <pre className="code">{r.text}</pre>
              {r.metadata && <pre className="code small">{JSON.stringify(r.metadata, null, 2)}</pre>}
            </div>
          ))}
        </div>
      </>)}
    </div>
  )
}
"""

