@app.post("/ingest/text")
def ingest_text_endpoint(payload: IngestTextRequest, db: Session = Depends(get_db)):
    doc_id, n_chunks = ingest_text(
        db,
        text=payload.text,
        title=payload.title,
        source=payload.source,
        metadata=payload.metadata,
        chunk_size=payload.chunk_size,
        chunk_overlap=payload.chunk_overlap,
        embedding_model=EMBED_MODEL,
    )
    return {"document_id": doc_id, "chunks": n_chunks}

@app.get("/search", response_model=List[SearchResponseItem])
def search_endpoint(q: str, top_k: int = 5, db: Session = Depends(get_db)):
    q_emb = embed_query(q, EMBED_MODEL)
    rows = search(db, q_emb, top_k=top_k)
    resp = []
    for r in rows:
        resp.append(SearchResponseItem(
            chunk_id=r["id"],
            document_id=r["document_id"],
            score=float(r["score"]),
            text=r["text"],
            metadata=r["metadata"]
        ))
    return resp

