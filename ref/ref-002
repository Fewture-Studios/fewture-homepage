# ingest.py
ingest_py = """from typing import List, Dict
from sqlalchemy.orm import Session
from models import Document, Chunk
import numpy as np
from sentence_transformers import SentenceTransformer

def _chunk_text(text: str, chunk_size=1200, chunk_overlap=200) -> List[str]:
    chunks = []
    i = 0
    while i < len(text):
        end = min(i + chunk_size, len(text))
        chunks.append(text[i:end])
        if end == len(text): break
        i = end - chunk_overlap
    return chunks

def embed_texts(texts: List[str], model_name: str) -> List[List[float]]:
    model = SentenceTransformer(model_name)
    embs = model.encode(texts, normalize_embeddings=True)
    return embs.tolist()

def ingest_text(db: Session, text: str, title: str = None, source: str = None, metadata: Dict = None,
                chunk_size: int = 1200, chunk_overlap: int = 200, embedding_model: str = "sentence-transformers/all-MiniLM-L6-v2"):
    doc = Document(title=title, source=source, metadata=metadata or {})
    db.add(doc)
    db.commit()
    db.refresh(doc)

    chunks = _chunk_text(text, chunk_size, chunk_overlap)
    embs = embed_texts(chunks, embedding_model)

    for t, e in zip(chunks, embs):
        c = Chunk(document_id=doc.id, text=t, embedding=e, metadata=metadata or {})
        db.add(c)
    db.commit()
    return doc.id, len(chunks)
"""

# rag.py
rag_py = """from typing import List, Dict, Any
from sqlalchemy.orm import Session
from sqlalchemy import text as sql_text
from models import Chunk
import os

EMBEDDING_DIM = 384

def search(db: Session, q_emb: List[float], top_k: int = 5):
    # pgvector cosine similarity: 1 - (embedding <#> q_emb) for inner product or use <=> for euclidean
    stmt = sql_text(\"\"\"
        SELECT id, document_id, text, metadata, 1 - (embedding <#> :query_vec) AS score
        FROM chunks
        ORDER BY embedding <#> :query_vec
        LIMIT :top_k
    \"\"\")
    rows = db.execute(stmt, {\"query_vec\": q_emb, \"top_k\": top_k}).mappings().all()
    return rows

def embed_query(query: str, model_name: str):
    from sentence_transformers import SentenceTransformer
    model = SentenceTransformer(model_name)
    emb = model.encode([query], normalize_embeddings=True)[0].tolist()
    return emb

def build_context(chunks: List[Dict[str, Any]]) -> str:
    parts = []
    for r in chunks:
        parts.append(r[\"text\"].strip())
    return \"\\n\\n---\\n\\n\".join(parts)

def generate_answer(context: str, query: str, template: str = None, variables: Dict[str, Any] = None) -> str:
    # Placeholder LLM call – replace with your provider (OpenAI/Anthropic/etc.)
    # Here we just template a simple answer using the retrieved context.
    header = \"You are FewtureOS, an in-house creative engine. Answer the query using the context.\\n\\n\"
    prompt = header + f\"Context:\\n{context}\\n\\nQuery:\\n{query}\\n\\nAnswer:\\n\"
    return prompt + \"[LLM output would go here based on your provider]\"
"""

