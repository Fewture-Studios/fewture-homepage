def generate_endpoint(payload: GenerateRequest, db: Session = Depends(get_db)):
    q_emb = embed_query(payload.query, EMBED_MODEL)
    rows = search(db, q_emb, top_k=payload.top_k)
    context = build_context(rows)
    answer = generate_answer(context, payload.query, payload.template, payload.variables)
